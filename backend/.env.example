# Copy this file to .env and adjust as needed.

# "production"으로 설정하면 아래 JWT_SECRET_KEY/SESSION_SECRET_KEY가 예시 placeholder
# 값 그대로일 때 서버가 기동을 거부한다(database.py:_validate_secrets). 로컬 개발/CI에서는
# 비워두거나 development로 둔다 - 경고 로그만 남기고 정상 기동한다.
ENVIRONMENT=development

# PostgreSQL (matches docker-compose.yml host port mapping)
DATABASE_URL=postgresql+psycopg2://dream_hub:dream_hub_password@localhost:5433/dream_hub_db

# Redis (matches docker-compose.yml host port mapping)
REDIS_URL=redis://localhost:6380/0

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Session (구글 OAuth state/nonce 저장용 서명 키 - JWT_SECRET_KEY와 다른 값 권장)
SESSION_SECRET_KEY=change-this-session-secret

# 이메일 인증 / 비밀번호 재설정 (SMTP)
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@dreamhub.dev
SMTP_FROM_NAME=Dream Hub

# 구글 OAuth 2.0 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# AI 꿈 해몽 (platform.claude.com 콘솔에서 발급한 Anthropic API 키)
ANTHROPIC_API_KEY=

# 자유 광장 이미지 첨부 (Cloudflare R2 - S3 호환 오브젝트 스토리지)
# Cloudflare 대시보드 > R2 > 버킷 생성 후, R2 API 토큰(계정 API 토큰이 아닌 R2 전용 토큰)을 발급받아 채운다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 버킷의 Public Development URL 또는 연결한 커스텀 도메인 (끝에 슬래시 없이)
R2_PUBLIC_BASE_URL=
