# Copy to .env.local for local dev, or set directly in your hosting
# platform's environment variables (e.g. Cloudflare Pages project settings).
#
# Falls back to http://localhost:8000 if not set.
NEXT_PUBLIC_API_URL=

# 구글 애드센스 승인 코드 (예: ca-pub-1234567890123456) - 비워두면 스크립트가 삽입되지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
